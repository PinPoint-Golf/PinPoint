    { "id": "archetype_bowed",  "label": "Bowed style",   "parent": "full_swing" },
    { "id": "archetype_cupped", "label": "Cupped style",  "parent": "full_swing" },

    { "id": "partial",      "label": "Partial swing",     "parent": "any" },
    { "id": "pitch",        "label": "Pitch",             "parent": "partial" },
    { "id": "chip",         "label": "Chip",              "parent": "partial" },

    { "id": "putt",         "label": "Putt",              "parent": "any" },

    { "id": "bunker",       "label": "Bunker",            "parent": "any" },
    { "id": "specialty",    "label": "Specialty shot",    "parent": "any" }
  ]
}
